name: donor_app
description: A donor module of the FYP

# The following line prevents the package from being accidentally published to
# pub.dev using `flutter pub publish`. This is preferred for private packages.
publish_to: "none" # Remove this line if you wish to publish to pub.dev

# https://developer.apple.com/library/archive/documentation/General/Reference/InfoPlistKeyReference/Articles/CoreFoundationKeys.html
version: 1.0.0+1

environment:
  sdk: ">=2.17.6 <4.0.0"

dependencies:
  flutter:
    sdk: flutter
  #intl: ^0.18.0
  #intl: ^0.17.0-nullsafety.2
  #intl: ^0.17.0
  firebase_auth: ^6.7.0
  easy_localization: ^3.0.1
  translator: ^1.0.4+1
  # easypaisa_flutter: ^1.0.0
  # provider: ^4.1.2
  permission_handler: ^13.0.2

  # The following adds the Cupertino Icons font to your application.
  # Use with the CupertinoIcons class for iOS style icons.
  cupertino_icons: ^2.0.0
  google_fonts: ^9.0.0
  #google_fonts: ^3.0.1
  pie_chart: ^5.3.2
  custom_navigation_bar: ^0.8.2
  #firebase_auth: ^4.4.2
  #firebase_auth: ^4.2.5
  firebase_core: ^4.15.0
  cloud_firestore: ^6.10.0
  firebase_storage: ^13.6.0
  pinput: ^7.0.0
  get: ^4.6.5
  provider: ^6.0.5
  modal_progress_hud_nsn: ^0.5.1
  google_maps_flutter: ^2.2.4
  location: ^10.0.2
  flutter_polyline_points: ^3.1.0
  d_chart: ^3.0.0
  flutter_map: ^8.3.2
  geolocator: ^14.1.1
  flutter_svg: ^2.0.5
  table_calendar: ^3.0.2

dev_dependencies:
  flutter_test:
    sdk: flutter

  flutter_lints: ^6.0.0

flutter:
  uses-material-design: true
  generate: true

  # To add assets to your application, add an assets section, like this:
  assets:
    - images/
    - translations/

  fonts:
    - family: Inter
      fonts:
        - asset: fonts/Inter-Regular.ttf
        - asset: fonts/Inter-Bold.ttf
        - asset: fonts/Inter-Light.ttf
        - asset: fonts/Inter-Medium.ttf
        - asset: fonts/Inter-SemiBold.ttf
        - asset: fonts/Inter-Thin.ttf
    - family: Nastaleeq
      fonts:
        - asset: fonts/Nastaleeq.ttf
